import React, { useState, useRef, useEffect } from 'react';
import { Html5QrcodeScanner } from 'html5-qrcode';
import 'bootstrap/dist/css/bootstrap.min.css';
import { motion } from 'framer-motion';

const QRScannerPage = () => {
  const [scanResult, setScanResult] = useState(null);
  const [isScanning, setIsScanning] = useState(true);
  const [registrationData, setRegistrationData] = useState(null);
  const [error, setError] = useState(null);
  const scannerRef = useRef(null);

  useEffect(() => {
    // Initialize the scanner only if we're in scanning mode
    if (isScanning && !scannerRef.current) {
      const scanner = new Html5QrcodeScanner('reader', {
        qrbox: {
          width: 250,
          height: 250
        },
        fps: 10,
        rememberLastUsedCamera: true,
      });
      
      scanner.render(onScanSuccess, onScanFailure);
      scannerRef.current = scanner;
    }
    
    // Cleanup function
    return () => {
      if (scannerRef.current) {
        try {
          scannerRef.current.clear();
        } catch (error) {
          console.error("Error clearing scanner:", error);
        }
      }
    };
  }, [isScanning]);

  const onScanSuccess = (decodedText) => {
    try {
      // Parse the QR data first to validate it's proper JSON
      const parsedData = JSON.parse(decodedText);
      
      // Only after successful parsing, update the state
      setIsScanning(false);
      setScanResult(decodedText);
      setRegistrationData(parsedData);
      
      // Clear the scanner
      if (scannerRef.current) {
        try {
          scannerRef.current.clear();
          scannerRef.current = null;
        } catch (error) {
          console.error("Error clearing scanner:", error);
        }
      }
    } catch (err) {
      console.error("QR code parsing error:", err);
      setError('Invalid QR code format. Please try again.');
    }
  };

  const onScanFailure = (error) => {
    // Handle scan failure silently - we don't want to show an error for every failed frame
  };

  const resetScanner = () => {
    setScanResult(null);
    setRegistrationData(null);
    setError(null);
    
    // Clear reference to allow re-initialization
    if (scannerRef.current) {
      try {
        scannerRef.current.clear();
        scannerRef.current = null;
      } catch (error) {
        console.error("Error during scanner reset:", error);
      }
    }
    
    // Set scanning after a short delay to ensure DOM is ready
    setTimeout(() => {
      setIsScanning(true);
    }, 100);
  };

  // Format ticket type for display
  const formatTicketType = (ticketType) => {
    if (!ticketType) return 'N/A';
    return ticketType.charAt(0).toUpperCase() + ticketType.slice(1);
  };

  // Format date for display
  const formatDate = (dateString) => {
    if (!dateString) return 'N/A';
    try {
      return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric', 
        month: 'long', 
        day: 'numeric'
      });
    } catch (error) {
      console.error("Date formatting error:", error);
      return dateString;
    }
  };

  // Determine payment status
  const getPaymentStatus = (data) => {
    // Check if card details exist - in a real application, you'd verify payment through your backend
    return data && data.cardNumber && data.cardExpiry && data.cardCvc ? 'Paid' : 'Pending';
  };

  return (
    <div className="container py-5">
      <motion.div 
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.5 }}
        className="card shadow-lg"
      >
        <div className="card-header bg-primary text-white">
          <h2 className="mb-0">Event Check-In</h2>
        </div>
        <div className="card-body">
          {error && (
            <div className="alert alert-danger" role="alert">
              {error}
              <button 
                className="btn-close float-end" 
                onClick={() => setError(null)}
                aria-label="Close"
              ></button>
            </div>
          )}
          
          {isScanning && !registrationData && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              transition={{ delay: 0.2 }}
              className="text-center"
            >
              <p className="mb-4">Scan attendee QR code</p>
              <div className="d-flex justify-content-center mb-4">
                <div
                  id="reader"
                  style={{ 
                    width: '100%', 
                    maxWidth: '500px',
                    borderRadius: '10px',
                    overflow: 'hidden'
                  }}
                ></div>
              </div>
              <p className="text-muted">Please allow camera access when prompted</p>
            </motion.div>
          )}
          
          {registrationData && (
            <motion.div 
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5 }}
            >
              <div className="text-center mb-4">
                <motion.div
                  initial={{ scale: 0 }}
                  animate={{ scale: 1 }}
                  transition={{ type: 'spring', stiffness: 200, damping: 20 }}
                  className="d-inline-flex justify-content-center align-items-center bg-success text-white rounded-circle p-3 mb-3"
                  style={{ width: '80px', height: '80px' }}
                >
                  <i className="bi bi-check-lg" style={{ fontSize: '2.5rem' }}></i>
                </motion.div>
                <h3 className="text-success">Ticket Verified!</h3>
              </div>
              
              <div className="card mb-4 border-success">
                <div className="card-header bg-success text-white">
                  <h4 className="mb-0">Ticket Information</h4>
                </div>
                <div className="card-body">
                  <div className="row text-center">
                    <div className="col-12 mb-4">
                      <h2>{registrationData.eventName}</h2>
                      <p className="lead">{formatDate(registrationData.eventDate)}</p>
                    </div>
                    
                    <div className="col-6">
                      <div className="card h-100">
                        <div className="card-body">
                          <h5 className="card-title">Ticket Type</h5>
                          <p className="card-text fs-4 fw-bold">{formatTicketType(registrationData.ticketType)}</p>
                        </div>
                      </div>
                    </div>
                    
                    <div className="col-6">
                      <div className="card h-100">
                        <div className="card-body">
                          <h5 className="card-title">Payment Status</h5>
                          <p className={`card-text fs-4 fw-bold ${getPaymentStatus(registrationData) === 'Paid' ? 'text-success' : 'text-warning'}`}>
                            {getPaymentStatus(registrationData)}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <div className="d-flex justify-content-center mt-4">
                <button
                  onClick={resetScanner}
                  className="btn btn-primary btn-lg"
                >
                  Scan Next Ticket
                </button>
              </div>
            </motion.div>
          )}
        </div>
      </motion.div>
    </div>
  );
};

export default QRScannerPage;
